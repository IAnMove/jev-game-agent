# Copy to .env and fill in your own values. .env is ignored by Git.
# Environment variables override this file. Paths may contain spaces.
TYPESAFE_API_KEY=
JEV_ROM=
JEV_BIZHAWK=
# Windows: JEV_BIZHAWK points to EmuHawk.exe.
# Linux, or Docker on macOS: point to the Linux build's EmuHawkMono.sh.
# Keep the complete emulator folder together; a single launcher is insufficient.
